# Local Keycloak demo settings. These values are for localhost development only.
NODE_ENV=development
OIDC_ISSUER=http://localhost:8081/realms/web-gis
OIDC_CLIENT_ID=web-gis-backend
OIDC_CLIENT_SECRET=webgis-local-client-secret
OIDC_REDIRECT_URI=http://localhost:3000/api/auth/callback
OIDC_ROLES_CLAIM=realm_access.roles
GIS_READ_ROLES=gis-reader,gis-editor,gis-admin

# Replace with a random secret of at least 32 characters. Keep it outside Git.
SESSION_SECRET=replace-with-a-random-secret-of-at-least-32-characters

# Browser origin(s) allowed to call the API, comma separated.
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173
SESSION_COOKIE_SAME_SITE=lax
TRUST_PROXY=false

# Development defaults to automatic migrations. Set false in production and
# run `npm run migrate` once as a controlled release step.
RUN_MIGRATIONS_ON_START=true
